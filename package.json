{
  "name": "ghost-browser",
  "productName": "Ghost Browser",
  "version": "1.2.0",
  "description": "Ghost — متصفح خفيف يعامل كل تاب كجهاز مستقل: جلسات معزولة، قروبات ببصمات ودول وتوقيتات مختلفة، مانع إعلانات مدمج، وتحديث تلقائي عن بُعد.",
  "descriptionEn": "A lightweight multi-identity browser: every tab is an isolated device, groups carry their own cookies, timezone, locale, fingerprint and proxy — with built-in ad blocking and auto-updates.",
  "main": "src/main/index.js",
  "author": {
    "name": "Ghost Browser",
    "email": "ghost@example.com"
  },
  "license": "MIT",
  "homepage": "https://github.com/qbrahym02-cmyk/ghost-browser",
  "repository": {
    "type": "git",
    "url": "https://github.com/qbrahym02-cmyk/ghost-browser.git"
  },
  "keywords": [
    "browser",
    "electron",
    "privacy",
    "antidetect",
    "multi-account",
    "adblock",
    "fingerprint",
    "profiles"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "node scripts/run-tests.mjs",
    "check": "node scripts/check-syntax.mjs",
    "icons": "node scripts/make-icons.mjs",
    "smoke": "node scripts/smoke.mjs",
    "shot": "electron tools/shot.js",
    "dist": "electron-builder --win",
    "dist:linux": "electron-builder --linux",
    "dist:mac": "electron-builder --mac",
    "dist:dir": "electron-builder --win --dir",
    "release": "electron-builder --win --publish always",
    "new-repo": "node scripts/push-to-github.mjs"
  },
  "dependencies": {
    "@ghostery/adblocker-electron": "^2.20.1",
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "electron": "45.1.0",
    "electron-builder": "^26.18.0",
    "qrcode-generator": "^1.4.4"
  }
}
